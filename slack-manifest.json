{
  "display_information": {
    "name": "Prediction Market",
    "description": "Create prediction markets and bet with fake money",
    "background_color": "#4A154B"
  },
  "features": {
    "bot_user": {
      "display_name": "Prediction Market",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/predict",
        "description": "Prediction market commands (try /predict help)",
        "usage_hint": "[create | markets | balance | leaderboard | help]",
        "should_escape": true
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "users:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
